# Copiază în `.env` și completează. `.env` nu se comite.

# Portul pe care ascultă API-ul.
PORT=3000

# Postgres. Valorile de mai jos se potrivesc cu serviciul din docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_USER=itbridge
DB_PASSWORD=dev_password
DB_NAME=itbridge_db

# Origini permise de CORS, separate prin virgulă. Fără variabilă, backend-ul acceptă
# https://itbridgeschool.com și http://localhost:3001.
CORS_ORIGINS=http://localhost:3001

# Secrete JWT. Obligatorii — fără ele, aplicația cade pe valori implicite previzibile
# (vezi src/constants/jwtConstants.ts).
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=

# S3, pentru PDF-urile de factură.
AWS_REGION=eu-central-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
