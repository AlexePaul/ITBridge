{
    "extends": "./tsconfig.json",
    // `scripts` is excluded on purpose: including it would pull the tsconfig rootDir up to the
    // package root, and `nest build` would emit `dist/src/main.js` instead of `dist/main.js`,
    // silently breaking `start:prod` and the deploy. The scripts run through ts-node anyway.
    "exclude": ["node_modules", "test", "dist", "scripts", "**/*spec.ts"]
}
