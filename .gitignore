.DS_Store

# Dependențe. Un singur store pnpm la rădăcină, plus symlink-urile per workspace.
node_modules/

# Artefacte de build și cache-uri.
dist/
.output/
.nuxt/
.turbo/

# Secrete și configurație locală. `.env.example` este versionat intenționat — vezi README.
.env
.env.*
!.env.example
!.env.stage.example

# Certificate și chei private. Nu se comit niciodată; TLS e gestionat de gazdă.
certs/
*.pem
*.key
*.crt
docs/legal/pdf/out/

# Written at every API boot by `main.ts`, relative to the process's working directory — so it
# lands here whenever the API is started from the repo root. CLAUDE.md has always said it was
# ignored; it was not.
swagger.json
