# node_linker rămâne pe valoarea implicită a pnpm, adică `isolated`: fiecare pachet vede în
# node_modules doar ce a declarat el însuși ca dependență, restul sunt symlink-uri către store-ul
# global adresabil prin conținut.
#
# Decizia e conștientă (E02, S2). Alternativa, `node-linker=hoisted`, reproduce arborele aplatizat
# al npm și ar face migrarea nedureroasă — dar exact asta e problema: ascunde dependențele
# nedeclarate, care merg local și cad în producție sau la prima instalare curată. Economia de
# spațiu vine din store-ul partajat, nu din aplatizare, deci nu se pierde nimic.
#
# Dacă o instalare eșuează cu „cannot find module X", răspunsul corect e `pnpm add X` în
# workspace-ul care îl folosește, nu comutarea pe hoisted.

# Refuză instalarea pe o versiune de Node în afara celei din `engines`, în loc să avertizeze.
engine-strict=true
