{
  "$schema": "https://turborepo.com/schema.json",

  // Turbo 2 defaults to `envMode: "strict"`: a task only sees the variables declared here, the
  // rest are hidden. That is a good default - it keeps the cache correct and makes environment
  // dependencies visible - but it means a new variable must be added to this list, otherwise it
  // simply "goes missing" with no message. The prefixes are wildcards Turbo accepts.
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "API_BASE",
    "SITE_URL",
    "RESEND_API_KEY",
    "CONTACT_FROM",
    // The backend's own mail settings, separate from the two above on purpose: E17 decided on two
    // Resend keys and two sending addresses, so that a burned quota or a revoked key on the public
    // contact form cannot silence the messages the school sends to parents.
    "MAIL_*",
    // The upload agent's own settings (E14/S2). It runs as a Windows service on a machine in the
    // school office and reads its own `.env`, not this one — but the prefix is declared here anyway,
    // because turbo's strict mode hides anything undeclared without a message, and the failure that
    // would produce is an agent that starts, heartbeats cheerfully and uploads nothing.
    "ITBRIDGE_*",
    // The accessibility gate's own switches (E18/S6): the port it serves the built site on, and
    // the two escape hatches for a machine whose Chromium is not the one Playwright installed.
    // `PLAYWRIGHT_*` is Playwright's own, `A11Y_*` is the script's.
    "A11Y_*",
    "PLAYWRIGHT_*",
    "VERCEL_ENV",
    "CORS_ORIGINS",
    "DB_*",
    "JWT_*",
    "AWS_*",
    "MINIO_*",
    "TEST_DB_NAME",
    "RATE_LIMIT_ENABLED",
    "SEED_ALLOW_NON_LOCAL",
    "SKIP_ENV_VALIDATION",
    // The ports the two browser guards serve the built site on. Declared because `test:privacy`
    // and `test:links` run through turbo: undeclared, the override was accepted by the shell and
    // dropped before the script ever saw it, so the one knob for a port clash did nothing at all.
    "LINK_CHECK_PORT",
    "THIRD_PARTY_PORT"
  ],

  // The root `.env` feeds into the cache hash: a configuration change invalidates the builds
  // instead of serving an artifact built with different values.
  "globalDependencies": [".env"],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // `.vercel/output` belongs here alongside the others: building on Vercel makes Nuxt use its
      // Vercel preset, which writes there instead of to `.output`. Left undeclared, a cache hit
      // restores nothing at that path while turbo replays the build log as if it had — and the
      // deploy then fails with "No Output Directory found", having seemingly just built fine.
      "outputs": ["dist/**", ".output/**", ".vercel/output/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    // A real browser against the built site, so it depends on the build of its own workspace —
    // `^build` would only bring what is underneath it, and the thing under test is the output.
    // Uncached: there is no artifact to restore, and a run that is skipped proves nothing.
    "test:a11y": {
      "dependsOn": ["build"],
      "cache": false
    },
    // Same shape, same reason, and it shares the browser and the preview server with the one
    // above through `scripts/preview-site.mjs`.
    "test:privacy": {
      "dependsOn": ["build"],
      "cache": false
    },
    // Third of the same family, same reasons.
    "test:links": {
      "dependsOn": ["build"],
      "cache": false
    },
    // The same gate as `test:a11y`, on the screens behind the login (E18/S6). The one difference
    // that matters is not visible here: it needs an API that answers and a database with the seed
    // in it, so it runs in the job that already has Postgres rather than beside the other three.
    "test:a11y:auth": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    }
  }
}
