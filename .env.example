# Configurația de dezvoltare, într-un singur loc. Copiază în `.env` la rădăcină:
#
#     cp .env.example .env
#
# `pnpm dev`, `pnpm build` și `pnpm dev:api` o încarcă și o transmit tuturor workspace-urilor,
# deci nu mai trebuie nicio variabilă pe linia de comandă.
#
# Un `apps/api/.env` continuă să fie citit, dacă există, și are prioritate — util pentru secrete
# pe care nu le vrei la rădăcină. În producție variabilele vin din mediu, prin PM2.

# --- Frontend ---
# URL-ul backend-ului, citit de Nuxt ca `runtimeConfig.public.apiBase`. Numele e `API_BASE`,
# nu `NUXT_PUBLIC_API_BASE`. Aceeași variabilă trebuie setată și în Vercel, inclusiv pe Preview.
API_BASE=http://localhost:3000

# Domeniul de pe care se servește site-ul. Intră în `<link rel="canonical">`, în `og:url`, în
# fiecare `<loc>` din sitemap.xml, în linia `Sitemap:` din robots.txt și în toate `@id`-urile din
# JSON-LD. Spre deosebire de `API_BASE`, pe asta **las-o nesetată în Vercel**: fără ea,
# `nuxt.config.ts` cade pe https://itbridgeschool.com, care e domeniul real. O valoare de
# localhost ajunsă în producție ar scoate tot site-ul din index. Setează-o doar dacă se mută
# domeniul, și atunci cu domeniul nou.
SITE_URL=http://localhost:3001

# Formularul de contact trimite prin Resend, dintr-o rută Nitro (`/api/contact`), nu din browser:
# cheia poate trimite mail în numele domeniului, deci nu are ce căuta în bundle-ul clientului.
# Fără ea, formularul răspunde 503 și trimite cititorul către adresa de email.
# Trebuie setată și în Vercel (Production și Preview), ca variabilă de server.
RESEND_API_KEY=

# Expeditorul. Domeniul lui trebuie verificat în Resend, altfel fiecare trimitere pică cu 403.
CONTACT_FROM="IT Bridge School <contact@itbridgeschool.com>"

# --- Backend ---
PORT=3000

# Postgres. Se potrivesc cu serviciul din docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_USER=itbridge
DB_PASSWORD=dev_password
DB_NAME=itbridge_db

# Origini permise de CORS, separate prin virgulă. Fără variabilă, backend-ul acceptă
# https://itbridgeschool.com și http://localhost:3001.
CORS_ORIGINS=http://localhost:3001

# Secrete JWT. Obligatorii: aplicația refuză să pornească fără ele, dacă au sub 16 caractere,
# dacă sunt egale între ele, sau dacă folosesc vechile valori implicite publicate în repo.
# Generează-le cu: openssl rand -base64 32
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=

# Limitarea de rată. Implicit pornită; `false` o oprește de tot — util doar dacă un CDN sau un WAF
# limitează deja în fața aplicației.
RATE_LIMIT_ENABLED=true

# Mailul trimis de backend (E17): notificări către părinți, memento-uri, alerte interne. Merge prin
# Resend, ca formularul de contact, dar cu CHEIE ȘI EXPEDITOR SEPARATE — decizia e din E17. Motivul:
# ruta publică de contact e deschisă oricui, iar limitarea ei de rată e per-instanță pe Vercel, deci
# o rafală poate consuma cota. Un anunț de anulare a unei ședințe nu are voie să împartă cota cu ea,
# iar revocarea unei chei compromise nu are voie să tacă celălalt canal.
#
# Ambele sunt OPȚIONALE: fără ele aplicația pornește normal, iar dezvoltarea locală merge fără mail.
# Ce se întâmplă atunci: mesajele se scriu în tabelul `outbox`, încercarea de trimitere eșuează
# controlat, iar motivul rămâne scris pe rând, în `lastError`. Nu se pierde nimic tăcut.
# Expeditorul trebuie să fie pe domeniul verificat în Resend, altfel fiecare trimitere pică cu 403.
# Nu `noreply@`: un părinte care primește un anunț de anulare apasă „răspunde", iar mesajul lui
# trebuie să ajungă undeva unde se uită cineva. Cutia de aici se redirectează către office@.
MAIL_RESEND_API_KEY=
MAIL_FROM="IT Bridge School <notificari@itbridgeschool.com>"

# `false` oprește scheduler-ul care golește coada; scrierea în coadă rămâne pornită. Testele de
# integrare o setează pe false, ca o trecere de fundal să nu miște rândurile sub aserțiuni.
MAIL_OUTBOX_ENABLED=true

# Adresa școlii, pentru mailul intern: azi, mementoul zilnic de la ora 10:00 cu ședințele de ieri
# rămase fără prezență marcată (E12). Opțională: nesetată, mesajul pleacă spre
# office@itbridgeschool.com, adresa publicată pe site. Există ca variabilă tocmai ca să poată fi
# schimbată fără deploy. Nu e adresa de expediere - aia e MAIL_FROM, de mai sus.
MAIL_OFFICE_ADDRESS=office@itbridgeschool.com

# AWS_REGION e obligatorie ca backend-ul să pornească: S3Service.onModuleInit aruncă fără ea.
AWS_REGION=eu-central-1

# Local, S3 e MinIO din docker-compose. `AWS_S3_ENDPOINT` scoate SDK-ul de pe AWS și îl trimite
# acolo; în producție variabila rămâne nesetată, iar SDK-ul rezolvă singur endpoint-ul din regiune.
# Consola MinIO e la http://localhost:9001, cu aceleași credențiale.
# Dacă porturile 9000 / 9001 sunt deja ocupate pe mașina ta, schimbă-le aici și potrivește
# AWS_S3_ENDPOINT cu MINIO_PORT.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_BUCKET=itbridge-local

# Local sunt și credențialele MinIO. În producție se lasă goale: fără ele, SDK-ul cade pe lanțul
# implicit de credențiale, adică IAM instance role (vezi E07, S6).
AWS_ACCESS_KEY_ID=itbridge
AWS_SECRET_ACCESS_KEY=dev_password

# --- Agentul de încărcare (E14) ---
# Cele de mai jos NU sunt pentru dezvoltare pe mașina ta: agentul rulează pe un singur calculator
# Windows din biroul școlii, cu propriul `.env` lângă executabil (vezi apps/agent/README.md). Sunt
# aici ca să existe un singur loc în care se vede ce cere fiecare parte a sistemului, și fiindcă
# `pnpm --filter agent start` local, cu API-ul pornit, e cel mai simplu mod de a-l încerca.
#
# Contul are rol ADMIN, fiindcă nu există altul — E09 a amânat rolurile. Credențiala poate deci tot
# ce poate un admin, inclusiv să emită facturi. E acceptat pentru că mașina stă într-un birou încuiat,
# și se reia la primul profesor care nu e proprietar.
ITBRIDGE_API_BASE=http://localhost:3000
ITBRIDGE_AGENT_USERNAME=
ITBRIDGE_AGENT_PASSWORD=
# Rădăcina partajării, așa cum o vede mașina aceea: `P:\Proiecte` sau `\\SRV\Proiecte`.
ITBRIDGE_AGENT_ROOT=
# Numele sub care raportează. Un rând per nume pe server, deci două birouri nu se suprascriu.
ITBRIDGE_AGENT_NAME=birou
